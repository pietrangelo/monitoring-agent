# Copy to .env and adjust for local docker-compose/podman-compose runs.
# .env is git-ignored; docker-compose.yml falls back to dev-only defaults
# if these are unset — replace them before using anything but a throwaway
# local sandbox.

# Shared secret system-agent must present when pushing to system-hub,
# and that system-hub requires from any pushing agent (HUB_PUSH_TOKEN).
HUB_PUSH_TOKEN=dev-hub-token

# REST API token required by system-agent's own HTTP endpoints.
SYSTEM_AGENT_TOKEN=dev-agent-token

# Seconds between push snapshots (system-agent -> system-hub).
PUSH_INTERVAL=2
